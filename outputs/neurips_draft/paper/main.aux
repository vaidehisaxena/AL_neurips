\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces End-to-end experimental workflow. All methods begin from matched initial observations. A GP summarizes the revealed data; the language-model controller allocates each batch across exploitation, uncertainty, and diversity queues; deterministic selection enforces uniqueness and access constraints; and the virtual assay reveals only the selected labels. Ten cycles produce a 360-compound endpoint. The complete decision log supports the core benchmark, next-batch forecast scoring, information ablations, and the operational availability experiment.\relax }}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:workflow}{{1}{2}{End-to-end experimental workflow. All methods begin from matched initial observations. A GP summarizes the revealed data; the language-model controller allocates each batch across exploitation, uncertainty, and diversity queues; deterministic selection enforces uniqueness and access constraints; and the virtual assay reveals only the selected labels. Ten cycles produce a 360-compound endpoint. The complete decision log supports the core benchmark, next-batch forecast scoring, information ablations, and the operational availability experiment.\relax }{figure.caption.2}{}}
